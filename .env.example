# ─────────────────────────────────────────────────────────────
#  .env.example  — Copy this file to .env and fill in your values.
#  NEVER commit the real .env file. The .gitignore already blocks it.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose — it's your project identifier)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose — RLS policies enforce access control)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────
#  NEVER add the following to this file or any frontend code:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - Database connection strings (postgres://...)
#   - Any secret API keys
# ─────────────────────────────────────────────────────────────
